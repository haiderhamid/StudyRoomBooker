@model Booking
@{
    ViewData["Title"] = "Delete booking";
}

<div class="form-shell form-shell-narrow">
    <header class="page-header">
        <h1 class="page-title">Delete booking?</h1>
        <p class="page-subtitle">The room will be free for others to book.</p>
    </header>

    <div class="card">
        <div class="card-body">
            <dl class="detail-list">
                <dt>Subject</dt>
                <dd>@Model.Subject</dd>
                <dt>Room</dt>
                <dd>Room @Model.Room?.RoomNumber, @Model.Room?.Building?.Name</dd>
                <dt>Date</dt>
                <dd>@Model.StartTime.ToString("dddd d MMMM", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</dd>
                <dt>Time</dt>
                <dd>@Model.StartTime.ToString("HH:mm")–@Model.EndTime.ToString("HH:mm")</dd>
                @if (User.IsInRole("Admin"))
                {
                    <dt>Booked by</dt>
                    <dd>@Model.BookedBy</dd>
                }
            </dl>

            <form asp-action="Delete" method="post" class="form-actions">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete booking</button>
                <a asp-action="Index" class="btn btn-quiet">Cancel</a>
            </form>
        </div>
    </div>
</div>
