@model BookingViewModel
@{
    ViewData["Title"] = "Edit booking";
}

<div class="booking-page">
    <header class="page-header">
        <h1 class="page-title">Edit booking</h1>
        <p class="page-subtitle">Change the room, day or time for this booking.</p>
    </header>

    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>

            <form asp-action="Edit" method="post" data-booking-form>
                <input type="hidden" asp-for="Booking.Id" />
                <div class="mb-3">
                    <label asp-for="Booking.RoomId" class="form-label">Room</label>
                    <select asp-for="Booking.RoomId" asp-items="Model.RoomSelectList" class="form-select">
                    </select>
                    <span asp-validation-for="Booking.RoomId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Booking.Subject" class="form-label">Subject</label>
                    <input asp-for="Booking.Subject" class="form-control" />
                    <span asp-validation-for="Booking.Subject" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Date" class="form-label">Date</label>
                    <input asp-for="Date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="FromTime" class="form-label">Start time</label>
                        <select asp-for="FromTime" asp-items="Model.TimeSelectList" class="form-select"></select>
                    </div>
                    <div class="col-6">
                        <label asp-for="ToTime" class="form-label">End time</label>
                        <select asp-for="ToTime" asp-items="Model.TimeSelectList" class="form-select"></select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Index" class="btn btn-quiet">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    <div id="booking-schedule" class="booking-schedule" data-url="@Url.Action("Schedule", "Room")" data-exclude="@Model.Booking.Id"
         aria-live="polite"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
