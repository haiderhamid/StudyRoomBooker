@model List<Booking>
@{
    ViewData["Title"] = "My bookings";
    var showPast = Context.Request.Query["view"] == "past";
    var today = DateTime.Today;
    var now = DateTime.Now;

    var visibleBookings = showPast
        ? Model.Where(b => b.EndTime <= now).OrderByDescending(b => b.StartTime)
        : Model.Where(b => b.EndTime > now).OrderBy(b => b.StartTime);

    var days = visibleBookings.GroupBy(b => b.StartTime.Date);
    var culture = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

<header class="page-header">
    <div>
        <h1 class="page-title">My bookings</h1>
        <p class="page-subtitle">The study rooms you have booked.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Book a room</a>
</header>

<nav class="segmented" aria-label="Show bookings">
    <a asp-action="Index" class="@(showPast ? "" : "is-active")" aria-current="@(showPast ? null : "page")">Upcoming</a>
    <a asp-action="Index" asp-route-view="past" class="@(showPast ? "is-active" : "")" aria-current="@(showPast ? "page" : null)">Past</a>
</nav>

@if (!days.Any())
{
    <div class="empty-state">
        <p>@(showPast ? "You have no past bookings." : "You have no upcoming bookings.")</p>
        @if (!showPast)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Find a room</a>
        }
    </div>
}

@foreach (var day in days)
{
    var heading = day.Key == today ? "Today"
        : day.Key == today.AddDays(1) ? "Tomorrow"
        : day.Key.ToString("dddd d MMMM", culture);

    <section class="day-group">
        <h2 class="day-heading">@heading</h2>
        <ul class="item-rows">
            @foreach (var booking in day)
            {
                <li class="item-row">
                    <span class="booking-time">@booking.StartTime.ToString("HH:mm")–@booking.EndTime.ToString("HH:mm")</span>
                    <div class="item-main">
                        <span class="item-title">@booking.Subject</span>
                        <span class="item-meta">
                            <a asp-controller="Room" asp-action="Details" asp-route-id="@booking.RoomId">Room @booking.Room?.RoomNumber</a> · @booking.Room?.Building?.Name
                        </span>
                    </div>
                    @if (booking.StartTime > now)
                    {
                        <div class="item-actions">
                            <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-quiet">Edit</a>
                            <a asp-action="Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-quiet btn-quiet-danger">Delete</a>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}
