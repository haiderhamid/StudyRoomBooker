@model Booking
@{
    ViewData["Title"] = "Booking has started";
}

<div class="form-shell form-shell-narrow">
    <header class="page-header">
        <h1 class="page-title">Booking has started</h1>
        <p class="page-subtitle">A booking that has already started cannot be changed.</p>
    </header>

    <div class="card">
        <div class="card-body">
            <dl class="detail-list">
                <dt>Subject</dt>
                <dd>@Model.Subject</dd>
                <dt>Room</dt>
                <dd>Room @Model.Room?.RoomNumber, @Model.Room?.Building?.Name</dd>
                <dt>Time</dt>
                <dd>@Model.StartTime.ToString("d MMMM HH:mm")–@Model.EndTime.ToString("HH:mm")</dd>
            </dl>
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to my bookings</a>
            </div>
        </div>
    </div>
</div>
