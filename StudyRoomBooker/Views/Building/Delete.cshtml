@model Building
@{
    ViewData["Title"] = "Delete building";
    var hasRooms = Model.Rooms != null && Model.Rooms.Any();
}

<div class="form-shell form-shell-narrow">
    <header class="page-header">
        <h1 class="page-title">Delete building?</h1>
        <p class="page-subtitle">@(hasRooms ? "This building cannot be deleted right now." : "This cannot be undone.")</p>
    </header>

    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>

            <dl class="detail-list">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
                <dt>Address</dt>
                <dd>@Model.Address</dd>
                <dt>Rooms</dt>
                <dd>@(Model.Rooms?.Count ?? 0)</dd>
            </dl>

            @if (hasRooms)
            {
                <p class="notice">This building has rooms. Delete or move the rooms first.</p>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to buildings</a>
                </div>
            }
            else
            {
                <form asp-action="Delete" method="post" class="form-actions">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete building</button>
                    <a asp-action="Index" class="btn btn-quiet">Cancel</a>
                </form>
            }
        </div>
    </div>
</div>
