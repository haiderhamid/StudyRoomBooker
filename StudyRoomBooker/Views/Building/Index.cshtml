@model List<Building>
@{
    ViewData["Title"] = "Buildings";
    var isAdmin = User.IsInRole("Admin");
}

<header class="page-header">
    <div>
        <h1 class="page-title">Buildings</h1>
        <p class="page-subtitle">The campus buildings that have study rooms.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Add building</a>
    }
</header>

@if (!Model.Any())
{
    <p class="empty-state">No buildings yet.</p>
}

<ul class="item-rows">
    @foreach (var building in Model)
    {
        var roomCount = building.Rooms?.Count ?? 0;
        <li class="item-row">
            <div class="item-main">
                <span class="item-title">@building.Name</span>
                <span class="item-meta">@building.Address</span>
            </div>
            <span class="room-tag">@(roomCount == 1 ? "1 room" : $"{roomCount} rooms")</span>
            @if (isAdmin)
            {
                <div class="item-actions">
                    <a asp-action="Edit" asp-route-id="@building.Id" class="btn btn-sm btn-quiet">Edit</a>
                    <a asp-action="Delete" asp-route-id="@building.Id" class="btn btn-sm btn-quiet btn-quiet-danger">Delete</a>
                </div>
            }
        </li>
    }
</ul>
