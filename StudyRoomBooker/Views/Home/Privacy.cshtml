@{
    ViewData["Title"] = "Privacy";
}

<div class="form-shell">
    <header class="page-header">
        <h1 class="page-title">Privacy</h1>
        <p class="page-subtitle">How StudyRoomBooker handles your data.</p>
    </header>

    <div class="card">
        <div class="card-body">
            <h2 class="day-heading">What we store</h2>
            <p>When you create an account we store your email address and a hashed password. When you book a room we store the room, the time, the subject and who made the booking.</p>
            <h2 class="day-heading">Who can see it</h2>
            <p>Everyone can see when a room is booked and the subject of the booking. Your email address is only shown to you and to administrators.</p>
            <h2 class="day-heading">Your choices</h2>
            <p class="mb-0">You can change or delete your own bookings at any time from My bookings.</p>
        </div>
    </div>
</div>
