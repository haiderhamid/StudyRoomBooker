@model Room
@{
    ViewData["Title"] = "Delete room";
    var hasBookings = ViewBag.HasBookings == true;
}

<div class="form-shell form-shell-narrow">
    <header class="page-header">
        <h1 class="page-title">Delete room?</h1>
        <p class="page-subtitle">@(hasBookings ? "This room cannot be deleted right now." : "This cannot be undone.")</p>
    </header>

    <div class="card">
        <div class="card-body">
            <dl class="detail-list">
                <dt>Room</dt>
                <dd>@Model.RoomNumber</dd>
                <dt>Building</dt>
                <dd>@Model.Building?.Name</dd>
                <dt>Seats</dt>
                <dd>@Model.Capacity</dd>
            </dl>

            @if (hasBookings)
            {
                <p class="notice">This room has bookings. Delete the bookings first.</p>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to rooms</a>
                </div>
            }
            else
            {
                <form asp-action="Delete" method="post" class="form-actions">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete room</button>
                    <a asp-action="Index" class="btn btn-quiet">Cancel</a>
                </form>
            }
        </div>
    </div>
</div>
