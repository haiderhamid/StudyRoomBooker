@model RoomDetailsViewModel
@{
    ViewData["Title"] = $"Room {Model.Room.RoomNumber}";
    var isAdmin = User.IsInRole("Admin");
}

<a asp-action="Index" class="back-link">‹ All rooms</a>

<header class="page-header">
    <div>
        <h1 class="page-title"><span class="room-prefix">@Model.Room.Building?.ShortName</span>@Model.Room.RoomNumber</h1>
        <p class="page-subtitle">@Model.Room.Building?.Name</p>
        <div class="room-tags">
            <span class="room-tag room-tag-capacity">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <circle cx="8" cy="5" r="3" fill="currentColor" />
                    <path d="M2 14c0-3.3 2.7-5 6-5s6 1.7 6 5" fill="currentColor" />
                </svg>
                @Model.Room.Capacity @(Model.Room.Capacity == 1 ? "seat" : "seats")
            </span>
            @if (Model.Room.RoomFacilities != null)
            {
                @foreach (var rf in Model.Room.RoomFacilities)
                {
                    <span class="room-tag">@rf.Facility?.Name</span>
                }
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <a asp-action="Edit" asp-route-id="@Model.Room.Id" class="btn btn-outline-secondary">Edit room</a>
        }
        <a asp-controller="Booking" asp-action="Create" asp-route-roomId="@Model.Room.Id" class="btn btn-primary">Book this room</a>
    </div>
</header>

<partial name="_WeekSchedule" model="Model.Schedule" />
