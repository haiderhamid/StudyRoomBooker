@model RoomViewModel
@{
    ViewData["Title"] = "Edit room";
}

<div class="form-shell">
    <header class="page-header">
        <h1 class="page-title">Edit room</h1>
        <p class="page-subtitle">Change the details for this room.</p>
    </header>

    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Room.Id" />
                <div class="mb-3">
                    <label asp-for="Room.RoomNumber" class="form-label">Room number</label>
                    <input asp-for="Room.RoomNumber" class="form-control" />
                    <span asp-validation-for="Room.RoomNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Room.BuildingId" class="form-label">Building</label>
                    <select asp-for="Room.BuildingId" asp-items="Model.BuildingSelectList" class="form-select">
                    </select>
                    <span asp-validation-for="Room.BuildingId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Room.Capacity" class="form-label">Seats</label>
                    <input asp-for="Room.Capacity" class="form-control" />
                    <span asp-validation-for="Room.Capacity" class="text-danger"></span>
                </div>
                <fieldset>
                    <legend class="form-label">Equipment</legend>
                    <div class="chip-group">
                        @foreach (var facility in Model.AllFacilities)
                        {
                            <input type="checkbox" class="btn-check" name="SelectedFacilityIds" value="@facility.Id"
                                   id="facility-@facility.Id" checked="@Model.SelectedFacilityIds.Contains(facility.Id)" />
                            <label class="chip" for="facility-@facility.Id">@facility.Name</label>
                        }
                    </div>
                </fieldset>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Index" class="btn btn-quiet">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
