@model ErrorViewModel
@{
    var isNotFound = Model.StatusCode == 404;
    ViewData["Title"] = isNotFound ? "Page not found" : "Something went wrong";
}

<div class="form-shell form-shell-narrow">
    <header class="page-header">
        <h1 class="page-title">@(isNotFound ? "Page not found" : "Something went wrong")</h1>
        <p class="page-subtitle">
            @(isNotFound
                ? "The page or item you are looking for does not exist."
                : "We could not complete your request. Please try again.")
        </p>
    </header>

    <div class="form-actions justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Find a room</a>
    </div>

    @if (Model.ShowRequestId && !isNotFound)
    {
        <p class="form-switch-link">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
