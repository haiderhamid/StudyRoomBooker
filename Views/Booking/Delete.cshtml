@model Booking

<h1 class="mb-4">Delete Booking</h1>

<div class="card shadow-sm" style="max-width: 500px;">
    <div class="card-body">
        <p class="text-danger">Are you sure you want to delete this booking?</p>

        <dl class="row">
            <dt class="col-sm-4">Room</dt>
            <dd class="col-sm-8">@Model.Room?.RoomNumber (@Model.Room?.Building)</dd>

            <dt class="col-sm-4">Subject</dt>
            <dd class="col-sm-8">@Model.Subject</dd>

            <dt class="col-sm-4">Start Time</dt>
            <dd class="col-sm-8">@Model.StartTime.ToString("g")</dd>

            <dt class="col-sm-4">End Time</dt>
            <dd class="col-sm-8">@Model.EndTime.ToString("g")</dd>

            <dt class="col-sm-4">Booked By</dt>
            <dd class="col-sm-8">@Model.BookedBy</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>