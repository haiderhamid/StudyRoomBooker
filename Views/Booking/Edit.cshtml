@model Booking

<h1>Edit Booking</h1>

<div asp-validation-summary="All"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label asp-for="RoomId"></label>
        <input asp-for="RoomId" />
        <span asp-validation-for="RoomId"></span>
    </div>
    <div>
        <label asp-for="Subject"></label>
        <input asp-for="Subject" />
        <span asp-validation-for="Subject"></span>
    </div>
    <div>
        <label asp-for="StartTime"></label>
        <input asp-for="StartTime" />
        <span asp-validation-for="StartTime"></span>
    </div>
    <div>
        <label asp-for="EndTime"></label>
        <input asp-for="EndTime" />
        <span asp-validation-for="EndTime"></span>
    </div>
    <div>
        <label asp-for="BookedBy"></label>
        <input asp-for="BookedBy" />
        <span asp-validation-for="BookedBy"></span>
    </div>
    <button type="submit">Save</button>
</form>