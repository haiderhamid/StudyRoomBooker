@model BookingViewModel

<h1 class="mb-4">Edit Booking</h1>

<div class="card shadow-sm" style="max-width: 500px;">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Booking.Id" />
            <div class="mb-3">
                <label asp-for="Booking.RoomId" class="form-label">Room</label>
                <select asp-for="Booking.RoomId" asp-items="Model.RoomSelectList" class="form-select"></select>
                <span asp-validation-for="Booking.RoomId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Booking.Subject" class="form-label"></label>
                <input asp-for="Booking.Subject" class="form-control" />
                <span asp-validation-for="Booking.Subject" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Booking.StartTime" class="form-label"></label>
                <input asp-for="Booking.StartTime" class="form-control" />
                <span asp-validation-for="Booking.StartTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Booking.EndTime" class="form-label"></label>
                <input asp-for="Booking.EndTime" class="form-control" />
                <span asp-validation-for="Booking.EndTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Booking.BookedBy" class="form-label"></label>
                <input asp-for="Booking.BookedBy" class="form-control" />
                <span asp-validation-for="Booking.BookedBy" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>